#version 450
precision mediump float;

// 16x16 workgroup layout optimized for mobile tile-based GPUs (Adreno / Mali)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D InputTexture;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D OutputTexture;

layout(push_constant) uniform PushConstants {
    float srcWidth;
    float srcHeight;
    float dstWidth;
    float dstHeight;
    float sharpness;
    float scaleFactor;
    uint flags;
    uint reserved;
} pc;

// Fast Edge-Adaptive Spatial Reconstruction (Mobile FP16 5-Tap Kernel)
vec3 FilterEASU(sampler2D tex, vec2 uv, vec2 invSrcRes) {
    vec3 c = texture(tex, uv).rgb;
    vec3 n = texture(tex, uv + vec2(0.0, -invSrcRes.y)).rgb;
    vec3 s = texture(tex, uv + vec2(0.0,  invSrcRes.y)).rgb;
    vec3 w = texture(tex, uv + vec2(-invSrcRes.x, 0.0)).rgb;
    vec3 e = texture(tex, uv + vec2( invSrcRes.x, 0.0)).rgb;

    // Fast clamp bounds to prevent ringing
    vec3 minCol = min(c, min(min(n, s), min(w, e)));
    vec3 maxCol = max(c, max(max(n, s), max(w, e)));

    // Edge gradient estimation across color channels
    vec3 edge = abs((n + s) - (w + e));
    float edgeFactor = clamp(max(max(edge.r, edge.g), edge.b) * 2.0, 0.0, 0.5);

    // Dynamic directional blend
    vec3 smoothCol = (n + s + w + e + 4.0 * c) * 0.125;
    return clamp(mix(smoothCol, c, edgeFactor), minCol, maxCol);
}

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(OutputTexture);

    if (outCoord.x >= outSize.x || outCoord.y >= outSize.y) {
        return;
    }

    vec2 uv = (vec2(outCoord) + 0.5) / vec2(outSize);
    vec2 invSrcRes = vec2(1.0 / pc.srcWidth, 1.0 / pc.srcHeight);

    vec3 reconstructed = FilterEASU(InputTexture, uv, invSrcRes);

    imageStore(OutputTexture, outCoord, vec4(reconstructed, 1.0));
}
