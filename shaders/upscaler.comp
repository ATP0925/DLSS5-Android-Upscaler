#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input Game Render Target (e.g. 720p or lower internal resolution)
layout(binding = 0) uniform sampler2D InputTexture;

// Output Upscaled Target (e.g. 1080p / 1440p Screen Resolution)
layout(binding = 1, rgba8) writeonly uniform image2D OutputTexture;

layout(push_constant) uniform UpscaleConstants {
    vec2 inputResolution;
    vec2 outputResolution;
    float sharpness;     // 0.0 to 1.0 (CAS strength)
    float upscaleFactor; // e.g. 1.5x, 2.0x
} ubo;

// Contrast Adaptive Sharpening (CAS) Kernel
vec3 ApplyCAS(sampler2D tex, vec2 uv, vec2 texelSize, float sharpness) {
    vec3 c = texture(tex, uv).rgb;
    vec3 n = texture(tex, uv + vec2(0.0, -texelSize.y)).rgb;
    vec3 s = texture(tex, uv + vec2(0.0,  texelSize.y)).rgb;
    vec3 w = texture(tex, uv + vec2(-texelSize.x, 0.0)).rgb;
    vec3 e = texture(tex, uv + vec2( texelSize.x, 0.0)).rgb;

    // Local min & max for contrast preservation
    vec3 minColor = min(c, min(min(n, s), min(w, e)));
    vec3 maxColor = max(c, max(max(n, s), max(w, e)));

    // Weight calculation
    vec3 amp = clamp(min(minColor, 2.0 - maxColor) / (maxColor + 0.0001), 0.0, 1.0);
    vec3 peak = -sqrt(amp);
    vec3 weight = peak * sharpness;

    // Filter sum
    vec3 result = (n + s + w + e) * weight + c;
    vec3 weightSum = 1.0 + 4.0 * weight;

    return clamp(result / maxWeight(weightSum), 0.0, 1.0);
}

float maxWeight(vec3 w) {
    return max(w.r, max(w.g, w.b));
}

void main() {
    ivec2 outputCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(OutputTexture);

    if (outputCoord.x >= outSize.x || outputCoord.y >= outSize.y) {
        return;
    }

    vec2 uv = (vec2(outputCoord) + 0.5) / vec2(outSize);
    vec2 texelSize = 1.0 / ubo.inputResolution;

    // Run Adaptive Spatial Filtering + Contrast Sharpening
    vec3 upscaledColor = ApplyCAS(InputTexture, uv, texelSize, ubo.sharpness);

    imageStore(OutputTexture, outputCoord, vec4(upscaledColor, 1.0));
}

