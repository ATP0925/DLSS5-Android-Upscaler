#version 450
precision mediump float;

// 16x16 workgroup layout optimized for mobile tile-based GPUs (Adreno / Mali)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D InputTexture;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D OutputTexture;

layout(push_constant) uniform PushConstants {
    float srcWidth;
    float srcHeight;
    float dstWidth;
    float dstHeight;
    float sharpness;
    float scaleFactor;
    uint flags;
    uint reserved;
} pc;

// Contrast-Adaptive Sharpening Kernel (FidelityFX CAS inspired)
vec3 FilterCAS(sampler2D tex, vec2 uv, vec2 invRes, float sharpness) {
    vec3 c = texture(tex, uv).rgb;
    vec3 n = texture(tex, uv + vec2(0.0, -invRes.y)).rgb;
    vec3 s = texture(tex, uv + vec2(0.0,  invRes.y)).rgb;
    vec3 w = texture(tex, uv + vec2(-invRes.x, 0.0)).rgb;
    vec3 e = texture(tex, uv + vec2( invRes.x, 0.0)).rgb;

    vec3 minCol = min(c, min(min(n, s), min(w, e)));
    vec3 maxCol = max(c, max(max(n, s), max(w, e)));

    // Contrast shaping factor
    vec3 amp = clamp(min(minCol, 2.0 - maxCol) / max(maxCol, 0.001), 0.0, 1.0);
    vec3 weight = -amp * (sharpness * 0.2);

    vec3 filtered = (n + s + w + e) * weight + c;
    vec3 weightSum = 1.0 + 4.0 * weight;

    return clamp(filtered / weightSum, 0.0, 1.0);
}

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(OutputTexture);

    if (outCoord.x >= outSize.x || outCoord.y >= outSize.y) {
        return;
    }

    vec2 uv = (vec2(outCoord) + 0.5) / vec2(outSize);
    vec2 invRes = vec2(1.0 / pc.dstWidth, 1.0 / pc.dstHeight);

    vec3 sharpened = FilterCAS(InputTexture, uv, invRes, pc.sharpness);

    imageStore(OutputTexture, outCoord, vec4(sharpened, 1.0));
}
